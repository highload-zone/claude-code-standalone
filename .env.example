# Environment Variables for MCP Servers
# Copy this file to .env and fill in your API keys.
# .env is gitignored and must NEVER be committed.

# --- Agent authentication ---
# Each agent image reads its own credentials. Any value present here is passed
# into the container, so one .env serves all three agents.
#
# Login persistence: agents that support an interactive login (`codex login`,
# `opencode auth login`, `claude auth login`) store their credentials under the
# mounted login directory, so the login survives a container restart. Env keys
# below are the alternative for headless/CI use.

# Claude Code OAuth Token - REQUIRED for the claude image
# Get your token via: claude setup-token (or from your organization)
CLAUDE_CODE_OAUTH_TOKEN=your_oauth_token_here

# Codex - API key for non-interactive runs (alternative: `codex login` in-container)
# Get one from https://platform.openai.com/api-keys
CODEX_API_KEY=your_codex_api_key_here

# OpenCode reads provider keys from the environment (alternative: `opencode auth login`).
# Pick the providers you use; unset ones are simply ignored.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- MCP servers ---
# Context7 - Required for the Context7 MCP server
# Get your API key from https://context7.com
CONTEXT7_API_KEY=your_context7_api_key_here

# Perplexity - Required for the Perplexity MCP server
# Get your API key from https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Permission bypass (optional, OFF by default). Default is auto mode (autonomous +
# background classifier). Set to 1 to add --dangerously-skip-permissions instead
# (full bypass, no in-app safety checks) — for isolated/throwaway containers only.
# CLAUDE_BYPASS_PERMISSIONS=1

# Remote Control is ON BY DEFAULT: --remote-control is passed on every session.
# Set to 0 to opt out (e.g. if your environment forbids that outbound channel).
# NOTE: it needs a full-scope login token (`claude auth login` inside the
# container); the inference-only CLAUDE_CODE_OAUTH_TOKEN above cannot drive
# Remote Control, and the entrypoint tells you so at startup.
# CLAUDE_REMOTE_CONTROL=0

# Prefix for auto-generated Remote Control session names (<prefix>-<words>).
# The launchers default it to your project directory name; the CLI default would
# be the container's throwaway hostname.
# CLAUDE_REMOTE_CONTROL_PREFIX=my-project

# Fan-out budgets. The image bakes tightened defaults for its --pids-limit=100
# cgroup: 12 concurrent subagents (upstream 20), 100 subagents and 100 web
# searches per session (upstream 200 each). Uncomment to override.
# NOTE: 0 does NOT disable the per-session counters — with either set to 0 the
# action still runs, i.e. 0 behaves as if the variable were unset. Use 1 for the
# tightest real limit.
# CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS=12
# CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION=100
# CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION=100

# Retry watchdog for unattended sessions (boolean: 1/true/yes/on). Baked to 1.
# CLAUDE_CODE_RETRY_WATCHDOG=1
