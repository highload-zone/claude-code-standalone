{
  "codegraph": {
    "type": "stdio",
    "command": "caveman-shrink",
    "args": ["codegraph", "serve", "--mcp"]
  },
  "codebase-memory-mcp": {
    "type": "stdio",
    "command": "codebase-memory-mcp",
    "args": []
  },
  "sequential-thinking": {
    "command": "mcp-server-sequential-thinking",
    "args": []
  },
  "context7": {
    "type": "http",
    "url": "https://mcp.context7.com/mcp",
    "headers": {
      "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
    }
  },
  "cloudflare-docs": {
    "type": "http",
    "url": "https://stack.mcp.cloudflare.com/mcp?libs=cloudflare,cloudflare-api,cloudflare-blog,cloudflare-community,vite,vitest"
  },
  "perplexity": {
    "command": "perplexity-mcp",
    "args": [],
    "env": {
      "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}"
    }
  }
}
