// Dev Container for the claude agent image (default config).
//
// Opens your project INSIDE the hardened container as an interactive development
// environment (VS Code Dev Containers, JetBrains Gateway, GitHub Codespaces, or
// the `devcontainer` CLI). This is distinct from run_agent.sh, which launches an
// autonomous agent TUI. Here YOU work in the container shell and invoke `claude`
// yourself when you want.
//
// Other agents: .devcontainer/codex/devcontainer.json and
// .devcontainer/opencode/devcontainer.json select their image tag.
//
// The image's ENTRYPOINT is intentionally NOT run: "overrideCommand": true makes
// the dev container keep itself alive with a sleep loop instead, so opening the
// workspace does not auto-launch the agent.
{
  "name": "agent-standalone (claude)",

  // Pull the published multi-arch image from GHCR. To pin a version, replace the
  // tag with a release tag, e.g. :1.2.3-claude.
  // To develop against a locally built image instead, comment "image" out and use:
  //   "build": { "dockerfile": "../../Dockerfile", "target": "claude" }
  "image": "ghcr.io/highload-zone/claude-code-standalone:claude",

  "overrideCommand": true,

  // Run as the image's non-root user. updateRemoteUserUID remaps that user's
  // uid/gid to the host user's so files created in the bind-mounted workspace are
  // owned by you (host uid 1000 != image uid 1001 → remap is required for writes).
  "remoteUser": "claude",
  "updateRemoteUserUID": true,

  // One level below /workspace on purpose: codebase-memory-mcp refuses to index a
  // first-level path as a root since v0.10.0, and /workspace is the CBM_ALLOWED_ROOT
  // boundary the image bakes in. All entrypoints use this same path.
  "workspaceFolder": "/workspace/project",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/project,type=bind,consistency=cached",

  // Hardened profile with a raised pids cap for interactive dev (test runners /
  // language servers / builds fork many processes).
  "runArgs": [
    "--cap-drop=ALL",
    "--cap-add=CHOWN",
    "--cap-add=DAC_OVERRIDE",
    "--cap-add=FOWNER",
    "--cap-add=SETUID",
    "--cap-add=SETGID",
    "--security-opt=no-new-privileges:true",
    "--pids-limit=512"
  ],

  // API keys are taken from your host environment (export them, or `set -a; . ./.env`
  // before launching). Empty if unset — fill in for the matching MCP servers.
  "containerEnv": {
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}",
    "CONTEXT7_API_KEY": "${localEnv:CONTEXT7_API_KEY}",
    "PERPLEXITY_API_KEY": "${localEnv:PERPLEXITY_API_KEY}"
  }
}